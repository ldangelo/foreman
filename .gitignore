# Backend (Elixir/Phoenix) — scoped to packages/foreman_server
/packages/foreman_server/_build
/packages/foreman_server/deps
/packages/foreman_server/.fetch
/packages/foreman_server/tmp
/packages/foreman_server/erl_crash.dump
/packages/foreman_server/*.ez
/packages/foreman_server/.elixir_ls
/packages/foreman_server/cover
/packages/foreman_server/excover
/packages/foreman_server/doc

# Language server (repo-root, if any)
/.elixir_ls

# Node (if mixed frontend)
/node_modules
/dist

# Editor/IDE
/.vscode
/.idea
*.iml
.env.local

# macOS
.DS_Store

# Coverage reports (repo-root, if any)
/cover
/excover

# Certs / secrets (never commit)
/*.pem
/*.key
/secrets/

# Crash dumps
*.dump

# macOS quarantine artifacts
.Compatibility*

# bv (beads viewer) local config and caches
.bv/
# br doctor per-run artifacts
.doctor/

# br corruption recovery directory (forensic-preserve on disk, hidden from VCS)
.beads.bad/

# Scout artifacts (per-task markdown output, regenerated each run)
.local/scout/*.md
# CLI escript build artifacts
/packages/foreman_cli/foreman
# Repo-root foreman binary
/foreman
/tmp/

# Local env (secrets, must never be tracked)
.env
.env.*

# OMP plugin state (local agent config)
.omp/

# Vendored jido_harness (TRD-001) build artifacts
/packages/jido_harness/_build/
/packages/jido_harness/cover/
/packages/jido_harness/erl_crash.dump
/packages/jido_harness/deps/**/_build
/packages/jido_harness/deps/**/priv/native
/packages/jido_harness/deps/**/c_src/_build

# Vendored C source build outputs (erlexec native compile)
/packages/jido_harness/deps/erlexec/c_src/*.o
/packages/jido_harness/deps/erlexec/c_src/*.d
/packages/jido_harness/deps/erlexec/priv/*/exec-port
/packages/jido_harness/deps/erlexec/priv/*/exec-port.sock
/packages/jido_harness/_build/**
/packages/jido_harness/cover/**
/packages/jido_harness/deps/**/_build/**

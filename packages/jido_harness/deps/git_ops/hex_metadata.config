{<<"links">>,
 [{<<"Changelog">>,
   <<"https://github.com/zachdaniel/git_ops/blob/master/CHANGELOG.md">>},
  {<<"GitHub">>,<<"https://github.com/zachdaniel/git_ops">>}]}.
{<<"name">>,<<"git_ops">>}.
{<<"version">>,<<"2.10.0">>}.
{<<"description">>,
 <<"A tool for managing the version and changelog of a project using conventional commits.">>}.
{<<"elixir">>,<<"~> 1.6">>}.
{<<"files">>,
 [<<"lib">>,<<"lib/git_ops">>,<<"lib/git_ops/commit.ex">>,
  <<"lib/git_ops/git.ex">>,<<"lib/git_ops/version.ex">>,
  <<"lib/git_ops/config.ex">>,<<"lib/git_ops/version_replace.ex">>,
  <<"lib/git_ops/github.ex">>,<<"lib/git_ops/changelog.ex">>,<<"lib/mix">>,
  <<"lib/mix/tasks">>,<<"lib/mix/tasks/git_ops.release.ex">>,
  <<"lib/mix/tasks/git_ops.project_info.ex">>,
  <<"lib/mix/tasks/git_ops.message_hook.ex">>,
  <<"lib/mix/tasks/git_ops.check_message.ex">>,
  <<"lib/mix/tasks/git_ops.install.ex">>,<<"lib/git_ops.ex">>,<<"priv">>,
  <<"priv/githooks">>,<<"priv/githooks/commit-msg.template">>,
  <<".formatter.exs">>,<<"mix.exs">>,<<"README.md">>,<<"CHANGELOG.md">>]}.
{<<"app">>,<<"git_ops">>}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"git_cli">>},
   {<<"app">>,<<"git_cli">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 0.2">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"igniter">>},
   {<<"app">>,<<"igniter">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<"~> 0.5 and >= 0.5.27">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"nimble_parsec">>},
   {<<"app">>,<<"nimble_parsec">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 1.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"req">>},
   {<<"app">>,<<"req">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 0.5">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"build_tools">>,[<<"mix">>]}.
